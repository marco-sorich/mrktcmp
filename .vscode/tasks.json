{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Gunicorn",
            "type": "shell",
            "command": "PYTHONPATH=/workspace gunicorn -b 0.0.0.0:8050 --reload src.app:server",
            "isBackground": true,
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            // Mirrors the CI pipeline: flake8 → mypy 2.1.0 → pytest.
            "label": "QA pipeline",
            "type": "shell",
            "command": "flake8 --max-complexity=10 --max-line-length=127 && mypy --explicit-package-bases --ignore-missing-imports src/backtest.py src/strategies/ && mypy --explicit-package-bases --ignore-missing-imports tests/test_backtest.py tests/test_strategies.py && pytest",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "killdebugger",
            "type": "shell",
            "command": "lsof -t -i tcp:8050 | xargs kill -9",
            "presentation": {
                "reveal": "never",
                "showReuseMessage": false
            },
            "hide": true
        }
    ]
}
