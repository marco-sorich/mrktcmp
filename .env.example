# =============================================================================
# mrktcmp - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it is in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Application Server
# -----------------------------------------------------------------------------
# PORT: The port the application listens on.
#       Most PaaS providers (Render, Fly.io, Railway, Heroku, etc.) set this
#       automatically. Default: 8050 for local development.
PORT=8050

# Gunicorn configuration (optional - override defaults from gunicorn.conf.py)
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=45

# -----------------------------------------------------------------------------
# Data Source
# -----------------------------------------------------------------------------
# BASE_URL: URL or local path to the parquet data files.
#           Example URL:    https://your-data-host.com/data
#           Example local:  /mnt/data
#           The app expects master.parquet and per-asset parquet files at this location.
BASE_URL=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# BASE_CURRENCY: Default reporting (base) currency pre-selected in the GUI.
#                Users can change this per run. Default: EUR.
BASE_CURRENCY=EUR

# LOG_LEVEL: Logging verbosity. One of: CRITICAL, ERROR, WARNING, INFO, DEBUG.
#            Default: INFO.
LOG_LEVEL=INFO

# DASH_DEBUG: Enable Dash dev tools (hot-reload, error overlay).
#             MUST be 'false' in production to avoid exposing internal details.
#             Default: false.
DASH_DEBUG=false
